<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Stocky’s 12‑Set Slider</title>

<style>
  body { margin:0; background:#111; color:#fff; font-family:Arial; }
  .slider-container { width:100%; max-width:900px; margin:auto; padding:20px; }
  .slide { display:none; }
  .slide img { width:100%; border-radius:10px; margin-bottom:10px; }
  .buttons { text-align:center; margin:20px 0; flex-wrap:wrap; }
  .buttons button {
    background:#fff; color:#000; padding:10px 20px;
    border:none; border-radius:5px; margin:5px; cursor:pointer;
    font-size:16px;
  }
  .buttons button:hover { background:#ccc; }
</style>
</head>

<body>

<div class="slider-container">

  <!-- SET 1 -->
  <div class="slide" id="set1">
    <img src="AMumsFrontBefore.png">
    <img src="AMumsFrontAfter.png">
  </div>

  <!-- SET 2 -->
  <div class="slide" id="set2">
    <img src="AEnineBayDetailBMWBeforejpg">
    <img src="AEngineBayDetailAfter.jpg">
  </div>

  <!-- SET 3 -->
  <div class="slide" id="set3">
    <img src="AMolliesBackseatBefore.jpg">
    <img src="AMolliesBackseatAfter.jpg">
  </div>

  <!-- SET 4 -->
  <div class="slide" id="set4">
    <img src="AMolliesPassSeatBefore.jpg">
    <img src="AMolliesPassSeatAfter.jpg">
  </div>

  <!-- SET 5 -->
  <div class="slide" id="set5">
    <img src="AMumsBackseatsBefore.jpg">
    <img src="AMumsBackSeatAfter.png">
  </div>

  <!-- SET 6 -->
  <div class="slide" id="set6">
    <img src="ASamsAlloyBefore.jpg">
    <img src="ASamsCarAlloyAfter.jpg">
  </div>

  <!-- SET 7 -->
  <div class="slide" id="set7">
    <img src="ASamsBootBefore.jpg">
    <img src="ASamsBootAfter.jpg">
  </div>

  <!-- SET 8 -->
  <div class="slide" id="set8">
    <img src="ASamsCarRearBefore.png">
    <img src="ASamsCarRearAfter.png">
  </div>

  <!-- SET 9 -->
  <div class="slide" id="set9">
    <img src="ASamsBackseatBefore.jpg">
    <img src="ASamsRearSeatsAfter.jpg">
  </div>

  <!-- SET 10 -->
  <div class="slide" id="set10">
    <img src="ASashasRearBefore.png">
    <img src="ASashaRearAfter.png">
  </div>

  <!-- SET 11 -->
  <div class="slide" id="set11">
    <img src="ASamsCupholdersBefore.jpg">
    <img src="ASamsCupholderAfter.jpg">
  </div>

  <!-- SET 12 -->
  <div class="slide" id="set12">
    <img src="ATomsVanBefore.png">
    <img src="ATomsVanAfter.png">
  </div>

</div>

<div class="buttons">
  <button onclick="showSlide('set1')">Set 1</button>
  <button onclick="showSlide('set2')">Set 2</button>
  <button onclick="showSlide('set3')">Set 3</button>
  <button onclick="showSlide('set4')">Set 4</button>
  <button onclick="showSlide('set5')">Set 5</button>
  <button onclick="showSlide('set6')">Set 6</button>
  <button onclick="showSlide('set7')">Set 7</button>
  <button onclick="showSlide('set8')">Set 8</button>
  <button onclick="showSlide('set9')">Set 9</button>
  <button onclick="showSlide('set10')">Set 10</button>
  <button onclick="showSlide('set11')">Set 11</button>
  <button onclick="showSlide('set12')">Set 12</button>
</div>

<script>
function showSlide(id) {
  document.querySelectorAll('.slide').forEach(s => s.style.display = 'none');
  document.getElementById(id).style.display = 'block';
}
showSlide('set1'); // default
</script>

</body>
</html>
